{
  "manifestVersion": 2,
  "id": "crew64-map",
  "name": "crew64 map",
  "version": "0.1.0",
  "description": "A sidebar panel and the worker that answers it.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "crew64-map",
        "title": "crew64 map",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "workspace.created"
      },
      {
        "on": "workspace.removed"
      },
      {
        "on": "agent.status.changed"
      }
    ],
    "settings": [
      {
        "key": "orcaCli",
        "title": "Orca CLI path",
        "description": "Path to the orca CLI shim. Empty uses ~/.config/orca/linux-orca-cli-shim/orca.",
        "type": "string",
        "maxLength": 512
      },
      {
        "key": "crew64Root",
        "title": "crew64 folder",
        "description": "Folder that holds tools/crew64_ledger.py. Empty uses $CREW64_ROOT, else the newest installed crew64 plugin.",
        "type": "string",
        "maxLength": 512
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    }
  ]
}
